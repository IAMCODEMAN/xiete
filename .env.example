# ============================================================================
# XIETE 环境变量配置模板（DeepSeek V4.1-Flash 适配版）
#
# 使用方式：
#   1. 复制本文件为 .env
#        Copy-Item .env.example .env   # PowerShell（推荐）
#        copy .env.example .env        # Windows CMD
#        cp .env.example .env          # macOS / Linux
#   2. 填入你在 https://platform.deepseek.com/api_keys 申请的 Key
#
# 配置文件查找顺序（先找到先生效）：
#   1. 进程已有的环境变量（最高优先级）
#   2. 当前工作目录下的 .env
#   3. 向上逐级回溯的项目根目录 .env（最多查找 5 层）
#
# 也可以完全不使用 .env，直接在终端里 export / set 环境变量。
# ============================================================================

# ---------------------------------------------------------------------------
# 【必填】API Key —— 由你提供
# 在 https://platform.deepseek.com/api_keys 创建，格式通常是 sk-xxxxxxxx
# 留空时 XIETE 会自动回退读取 DEEPSEEK_API_KEY，其次 OPENAI_API_KEY
# ---------------------------------------------------------------------------
XIETE_API_KEY=sk-your-deepseek-key-here

# ---------------------------------------------------------------------------
# 【必填】API Base URL —— DeepSeek 官方 OpenAI 兼容端点
# 注意：DeepSeek 的地址不带 /v1（写 https://api.deepseek.com/v1 也可用）
# ---------------------------------------------------------------------------
XIETE_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------------------
# 【必填】模型名
#   deepseek-flash    → DeepSeek-V4.1-Flash-1017（默认推荐，快且便宜）
#   deepseek-v4-pro   → DeepSeek-V4-Pro-0813（更强，更贵）
#
# 兼容别名（会自动归一为 deepseek-flash，但建议直接用规范名）：
#   deepseek-v4-flash / deepseek-v4.1-flash / deepseek-v4.1-flash-1017
# ---------------------------------------------------------------------------
XIETE_MODEL=deepseek-flash

# ============================================================================
# 以下为可选项，一般不填也能正常工作
# ============================================================================

# ---------------------------------------------------------------------------
# 思考模式（DeepSeek V4 默认开启）
#   enabled  = 开启，模型先输出思维链再给答案，编程任务准确率更高（推荐）
#   disabled = 关闭，响应更快更省 token，适合简单任务
#
# 重要：DeepSeek 思考模式下 temperature 不生效、tool_choice="required" 会报 400，
#       XIETE 已自动适配（自动改用 tool_choice="auto" 并回传 reasoning_content）。
# ---------------------------------------------------------------------------
XIETE_THINKING=enabled

# 思考强度：low / high / max（默认 high）。填写 none 等同于关闭思考模式
# XIETE_REASONING_EFFORT=high

# Agent 单次任务最多推理步数（默认 40）
# XIETE_MAX_STEPS=40

# 单次模型请求超时秒数（默认 300，思考模式较慢，不建议调太低）
# XIETE_TIMEOUT=300

# 温度（仅在 XIETE_THINKING=disabled 时生效；思考模式下 DeepSeek 会忽略它）
# XIETE_TEMPERATURE=0.2

# 自定义输入历史文件路径
# XIETE_HISTORY_FILE=C:\Users\you\.xiete\history

# ---------------------------------------------------------------------------
# 系统提示词追加文件（可选）
# 指向一个 .md / .txt 文件，其内容会【追加】在内置规则之后，优先级更高。
# 不设置时，会自动探测工作目录及上层目录下的 XIETE_PROMPT.md。
# 修改后需重启 xiete 生效（同一个会话内不会热更新）。
# ---------------------------------------------------------------------------
# XIETE_SYSTEM_PROMPT=.\XIETE_PROMPT.md
